# =============================================================================
# KIS (한국투자증권) API 인증 — Phase 1.1 Stage 2.2 (ADR 0012 R10 / ADR 0020 §2.1)
# =============================================================================
# ⚠️ 실머니 보안 경고 (ADR 0012 R10):
#   - 이 파일(.env.example)은 placeholder 만 담는 템플릿. 실값 절대 금지 → commit 가능.
#   - 실제 키는 `.env` 에만 입력하라. `.env` 는 .gitignore 등록됨 → commit 절대 금지.
#   - appkey / appsecret / access_token = 돈에 직접 연결. 노출 = 계좌 탈취.
#   - 개발/검증 = 모의투자(VTS, 기본 paper). 실전 키 = Stage 8 실거래 ON 에서만 채운다.
#
# 사용법:
#   cp .env.example .env
#   # .env 를 열어 모의투자 키(KIS_PAPER_*)를 채운다. 실전 키는 비워둔다.
# =============================================================================

# 거래 모드: paper(모의투자, 기본) | real(실계좌, Stage 8 에서만)
KIS_TRADING_MODE=paper

# --- 모의투자(VTS) — 개발/검증 기본 ---
KIS_PAPER_APPKEY=
KIS_PAPER_APPSECRET=
KIS_PAPER_ACCOUNT_CANO=          # 계좌번호 앞 8자리
KIS_PAPER_ACCOUNT_PRDT_CD=01     # 계좌상품코드 뒤 2자리

# --- 실계좌 — Stage 8 실거래 ON 전까지 비워둔다 ---
KIS_REAL_APPKEY=
KIS_REAL_APPSECRET=
KIS_REAL_ACCOUNT_CANO=
KIS_REAL_ACCOUNT_PRDT_CD=01

# =============================================================================
# 텔레그램 알림 (ADR 0012 D3). 미설정 시 console-only. 실값은 .env 만(commit 금지).
# =============================================================================
# ⚠️ TELEGRAM_BOT_TOKEN = secret (계정 탈취 위험) → 로깅/노출 금지(R10). chat_id 는 비밀 아님.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
